# Copy to .env.production and supply values for the deployment.
# Generate a key: docker compose run --rm --no-deps web python -c "import secrets; print(secrets.token_urlsafe(64))"
# Paste the key inside single quotes so Compose preserves any dollar signs.
DJANGO_SECRET_KEY=''
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
WAGTAILADMIN_BASE_URL=https://example.com

# Use a separate, strong database password, also enclosed in single quotes.
POSTGRES_DB=wagtail
POSTGRES_USER=wagtail
POSTGRES_PASSWORD=''
POSTGRES_HOST=db
POSTGRES_PORT=5432
# For managed PostgreSQL, use the provider's TLS settings (often verify-full).
POSTGRES_SSLMODE=prefer

# Uploaded files are stored in a separate persistent volume.
DJANGO_MEDIA_ROOT=/data/media

# Enable these once HTTPS is configured on the hosting proxy.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# Only enable when a trusted proxy strips and sets X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=false

GUNICORN_CMD_ARGS=--workers=2
